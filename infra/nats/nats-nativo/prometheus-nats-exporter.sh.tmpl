#!/usr/bin/env bash
set -euo pipefail

[[ ${NATS_EXPORTER_HTTP_USER:-} =~ ^[A-Za-z0-9._-]{1,64}$ ]] || {
  printf 'nats-exporter: invalid HTTP basic-auth user\n' >&2
  exit 1
}
[[ ${NATS_EXPORTER_HTTP_BCRYPT_PASSWORD:-} =~ ^\$2a\$[0-9]{2}\$[./A-Za-z0-9]{53}$ ]] || {
  printf 'nats-exporter: invalid bcrypt password hash\n' >&2
  exit 1
}

exec /usr/local/bin/prometheus-nats-exporter \
  -a NATS_EXPORTER_BIND_ADDRESS \
  -p 7777 \
  -varz \
  -connz \
  -subz \
  -jsz consumers \
  -healthz_js_enabled_only \
  -tlscert /etc/ensambria/credentials/nats/exporter.crt \
  -tlskey /etc/ensambria/credentials/nats/exporter.key \
  -http_user "$NATS_EXPORTER_HTTP_USER" \
  -http_pass "$NATS_EXPORTER_HTTP_BCRYPT_PASSWORD" \
  http://127.0.0.1:8222
