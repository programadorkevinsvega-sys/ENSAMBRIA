{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "NATS/JetStream y recursos del host. NATS es un broker, no un servicio HTTP de negocio; las métricas http_requests_total y http_request_duration_seconds_bucket deben proceder de cada servicio HTTP propietario.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "1. Resumen general",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "gnatsd_healthz_js_enabled_only_status_value{app=\"nats\",service=\"jetstream\",host=~\"$host\"}",
          "legendFormat": "JetStream health",
          "refId": "A"
        }
      ],
      "title": "JetStream health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "100 - avg by (host) (rate(node_cpu_seconds_total{app=\"nats\",service=\"node-exporter\",mode=\"idle\",host=~\"$host\"}[5m])) * 100",
          "legendFormat": "CPU {{host}}",
          "refId": "A"
        }
      ],
      "title": "CPU actual",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\"} / node_memory_MemTotal_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\"}) * 100",
          "legendFormat": "Memory",
          "refId": "A"
        }
      ],
      "title": "Memoria actual",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "node_load1{app=\"nats\",service=\"node-exporter\",host=~\"$host\"}",
          "legendFormat": "1m",
          "refId": "A"
        }
      ],
      "title": "Load average (1m)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"})",
          "legendFormat": "/",
          "refId": "A"
        }
      ],
      "title": "Disco raíz",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "up{job=\"ensambria-nats-node\",app=\"nats\",service=\"node-exporter\",host=~\"$host\"}",
          "legendFormat": "node_exporter",
          "refId": "A"
        }
      ],
      "title": "Node exporter target",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 101,
      "title": "2. Recursos del servidor",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 18,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "id": 7,
      "targets": [
        {
          "expr": "100 - avg by (host) (rate(node_cpu_seconds_total{app=\"nats\",service=\"node-exporter\",mode=\"idle\",host=~\"$host\"}[5m])) * 100",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "CPU usage %",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 18,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "id": 8,
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\"} / node_memory_MemTotal_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\"}) * 100",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Memory usage %",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "id": 9,
      "targets": [
        {
          "expr": "node_load1{app=\"nats\",service=\"node-exporter\",host=~\"$host\"}",
          "legendFormat": "1m",
          "refId": "A"
        },
        {
          "expr": "node_load5{app=\"nats\",service=\"node-exporter\",host=~\"$host\"}",
          "legendFormat": "5m",
          "refId": "B"
        },
        {
          "expr": "node_load15{app=\"nats\",service=\"node-exporter\",host=~\"$host\"}",
          "legendFormat": "15m",
          "refId": "C"
        }
      ],
      "title": "Load average",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 10,
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\"} - node_memory_MemAvailable_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\"}",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemAvailable_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\"}",
          "legendFormat": "Available",
          "refId": "B"
        },
        {
          "expr": "node_memory_Cached_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\"}",
          "legendFormat": "Cache",
          "refId": "C"
        },
        {
          "expr": "node_memory_Buffers_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\"}",
          "legendFormat": "Buffers",
          "refId": "D"
        }
      ],
      "title": "Memoria detallada",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 11,
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{app=\"nats\",service=\"node-exporter\",host=~\"$host\",device!~\"lo|veth.*|br.*|docker.*\"}[5m])",
          "legendFormat": "RX {{device}}",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{app=\"nats\",service=\"node-exporter\",host=~\"$host\",device!~\"lo|veth.*|br.*|docker.*\"}[5m])",
          "legendFormat": "TX {{device}}",
          "refId": "B"
        }
      ],
      "title": "Red (RX / TX)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 102,
      "title": "3. Disco e identidad del host",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 18,
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 12,
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{app=\"nats\",service=\"node-exporter\",host=~\"$host\",fstype!~\"tmpfs|overlay|squashfs\"})",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ],
      "title": "Filesystem usage by mountpoint",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 13,
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{app=\"nats\",service=\"node-exporter\",host=~\"$host\",device!~\"loop.*|ram.*\"}[5m])",
          "legendFormat": "Read {{device}}",
          "refId": "A"
        },
        {
          "expr": "rate(node_disk_written_bytes_total{app=\"nats\",service=\"node-exporter\",host=~\"$host\",device!~\"loop.*|ram.*\"}[5m])",
          "legendFormat": "Write {{device}}",
          "refId": "B"
        }
      ],
      "title": "Disk I/O (read / write)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 14,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "node_uname_info{app=\"nats\",service=\"node-exporter\",host=~\"$host\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Identificación del servidor (node_uname_info)",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "id": 103,
      "title": "4. NATS y JetStream",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "id": 15,
      "targets": [
        {
          "expr": "rate(gnatsd_varz_in_msgs{app=\"nats\",service=\"jetstream\",host=~\"$host\"}[5m])",
          "legendFormat": "Messages in/s",
          "refId": "A"
        },
        {
          "expr": "rate(gnatsd_varz_out_msgs{app=\"nats\",service=\"jetstream\",host=~\"$host\"}[5m])",
          "legendFormat": "Messages out/s",
          "refId": "B"
        }
      ],
      "title": "Message throughput",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "id": 16,
      "targets": [
        {
          "expr": "gnatsd_varz_connections{app=\"nats\",service=\"jetstream\",host=~\"$host\"}",
          "legendFormat": "Connections",
          "refId": "A"
        },
        {
          "expr": "gnatsd_varz_slow_consumers{app=\"nats\",service=\"jetstream\",host=~\"$host\"}",
          "legendFormat": "Slow consumers",
          "refId": "B"
        }
      ],
      "title": "Connections and slow consumers",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 47
      },
      "id": 17,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "jetstream_server_total_streams{app=\"nats\",service=\"jetstream\",host=~\"$host\"}",
          "legendFormat": "Streams",
          "refId": "A"
        },
        {
          "expr": "jetstream_server_total_consumers{app=\"nats\",service=\"jetstream\",host=~\"$host\"}",
          "legendFormat": "Consumers",
          "refId": "B"
        }
      ],
      "title": "JetStream totals",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 47
      },
      "id": 27,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "gnatsd_varz_cpu{app=\"nats\",service=\"jetstream\",host=~\"$host\"}",
          "legendFormat": "NATS server CPU",
          "refId": "A"
        }
      ],
      "title": "NATS server CPU %",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 47
      },
      "id": 28,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "gnatsd_varz_mem{app=\"nats\",service=\"jetstream\",host=~\"$host\"}",
          "legendFormat": "NATS server memory",
          "refId": "A"
        }
      ],
      "title": "NATS server memory",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "id": 18,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "jetstream_server_total_message_bytes{app=\"nats\",service=\"jetstream\",host=~\"$host\"}",
          "legendFormat": "Used",
          "refId": "A"
        },
