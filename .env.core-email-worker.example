# Dedicated environment file for /etc/apps/ensambria/core/email-worker.env.
# Provision this file through the deployment secret manager; owner root:root, mode 0600.
# DATABASE_URL must authenticate as core_email_worker, never core_runtime.
DATABASE_URL=postgres://CORE_EMAIL_WORKER:REPLACE_WITH_PASSWORD@POSTGRES_HOST:5432/ensambria
CORE_DATABASE_MAX_CONNECTIONS=3
CORE_DATABASE_ACQUIRE_TIMEOUT_MS=3000

# SMTP credentials are available only to the isolated worker process.
CORE_SMTP_HOST=smtp.example.com
CORE_SMTP_PORT=587
CORE_SMTP_USERNAME=REPLACE_WITH_SECRET
CORE_SMTP_PASSWORD=REPLACE_WITH_SECRET
CORE_SMTP_FROM=ENSAMBRIA <no-reply@example.com>
