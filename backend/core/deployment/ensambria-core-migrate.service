[Unit]
Description=Apply ENSAMBRIA CORE database migrations
After=network.target

[Service]
Type=oneshot
TimeoutStartSec=300
TimeoutStopSec=30
User=ensambria-core-migrator
Group=ensambria-core-migrator
SupplementaryGroups=ensambria-core-artifacts
WorkingDirectory=/opt/apps/ensambria
EnvironmentFile=/etc/apps/ensambria/core/.env
UnsetEnvironment=DATABASE_URL CORE_EMAIL_WORKER_DATABASE_URL CORE_EMAIL_WORKER_DATABASE_MAX_CONNECTIONS CORE_EMAIL_WORKER_DATABASE_ACQUIRE_TIMEOUT_MS CORE_EMAIL_WORKER_DATABASE_IDLE_TIMEOUT_MS CORE_EMAIL_WORKER_DATABASE_MAX_LIFETIME_MS CORE_SMTP_HOST CORE_SMTP_PORT CORE_SMTP_USERNAME CORE_SMTP_PASSWORD CORE_SMTP_FROM
ExecStart=/opt/apps/ensambria/current/core-migrate /opt/apps/ensambria/current/migrations
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
