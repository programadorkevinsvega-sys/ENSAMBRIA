[Unit]
Description=ENSAMBRIA CORE transactional email outbox worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ensambria-core
Group=ensambria-core
WorkingDirectory=/opt/apps/ensambria
EnvironmentFile=/etc/apps/ensambria/core/email-worker.env
ExecStart=/opt/apps/ensambria/current/core-email-worker
Restart=on-failure
RestartSec=10s
TimeoutStartSec=90s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SupplementaryGroups=ensambria-core-artifacts

[Install]
WantedBy=multi-user.target
