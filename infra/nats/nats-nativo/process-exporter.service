[Unit]
Description=ENSAMBRIA NATS VM process-exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=process-exporter
Group=process-exporter
SupplementaryGroups=nats-tls
ExecStart=/usr/local/bin/process-exporter -web.listen-address=NATS_EXPORTER_BIND_ADDRESS:9256 -web.config.file=/etc/ensambria/nats/process-exporter-web.yml -config.path=/etc/ensambria/nats/process-exporter.yml -children=false -threads=false -gather-smaps=false -remove-empty-groups
Restart=on-failure
RestartSec=3s
MemoryMax=256M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadOnlyPaths=/etc/ensambria/nats/process-exporter-web.yml /etc/ensambria/nats/process-exporter.yml /etc/ensambria/credentials/nats/process-exporter.crt /etc/ensambria/credentials/nats/process-exporter.key
UMask=0027

[Install]
WantedBy=multi-user.target
