      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 47
      },
      "id": 19,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "100 * gnatsd_varz_jetstream_stats_memory{app=\"nats\",service=\"jetstream\",host=~\"$host\"} / gnatsd_varz_jetstream_config_max_memory{app=\"nats\",service=\"jetstream\",host=~\"$host\"}",
          "legendFormat": "Memory store used",
          "refId": "A"
        }
