# Template only; replace every placeholder before installing this file on staging.
# Do not commit the real .env or copy this template without configuring it.

# Separate least-privilege PostgreSQL roles, pointing to the same CORE database.
# URL-encode special characters in database credentials.
DATABASE_URL=postgres://CORE_RUNTIME_USER:REPLACE_WITH_PASSWORD@POSTGRES_HOST:5432/ensambria
MIGRATIONS_DATABASE_URL=postgres://CORE_MIGRATOR_USER:REPLACE_WITH_PASSWORD@POSTGRES_HOST:5432/ensambria

# Dedicated email-worker database identity and independently bounded pool.
CORE_EMAIL_WORKER_DATABASE_URL=postgres://CORE_EMAIL_WORKER_USER:REPLACE_WITH_PASSWORD@POSTGRES_HOST:5432/ensambria
CORE_EMAIL_WORKER_DATABASE_MAX_CONNECTIONS=3
CORE_EMAIL_WORKER_DATABASE_ACQUIRE_TIMEOUT_MS=3000
# Optional:
# CORE_EMAIL_WORKER_DATABASE_IDLE_TIMEOUT_MS=REPLACE_WITH_APPROVED_TIMEOUT
# CORE_EMAIL_WORKER_DATABASE_MAX_LIFETIME_MS=REPLACE_WITH_APPROVED_TIMEOUT

# Resend SMTP secrets are loaded from this file by the email worker only.
CORE_SMTP_HOST=smtp.resend.com
CORE_SMTP_PORT=587
CORE_SMTP_USERNAME=resend
CORE_SMTP_PASSWORD=REPLACE_WITH_RESEND_SENDING_API_KEY
CORE_SMTP_FROM=ENSAMBRIA <no-reply@YOUR_VERIFIED_DOMAIN>

# Initial staging settings for one CORE process only; recalculate before production.
CORE_DATABASE_MAX_CONNECTIONS=5
CORE_DATABASE_ACQUIRE_TIMEOUT_MS=3000

# Optional SQLx pool limits; leave unset for staging unless measurements require them.
# CORE_DATABASE_IDLE_TIMEOUT_MS=REPLACE_WITH_APPROVED_TIMEOUT
# CORE_DATABASE_MAX_LIFETIME_MS=REPLACE_WITH_APPROVED_TIMEOUT

# Staging listeners are loopback-only; confirm these ports are unused on the CORE VM.
CORE_HEALTH_LISTEN_ADDRESS=127.0.0.1:18080
CORE_METRICS_LISTEN_ADDRESS=127.0.0.1:19090
CORE_HEALTH_CHECK_INTERVAL_MS=5000
CORE_HEALTH_CHECK_TIMEOUT_MS=2000

# Redis is cache-only. Inject the TLS URL from the secret manager in production.
# PLATFORM_REDIS_URL=rediss://REPLACE_WITH_SECRET_MANAGED_ENDPOINT

# Optional tracing filter; defaults to info when omitted.
RUST_LOG=info

# Authentication composition settings. Inject real values from the secret manager.
# The MFA key is 32 random bytes encoded as 64 hexadecimal characters.
# CORE_MFA_ENCRYPTION_KEY_VERSION=secret-manager-version-id
# CORE_MFA_ENCRYPTION_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
# CORE_AUTH_RATE_LIMIT_SECRET_HEX=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
# CORE_PUBLIC_BASE_URL=https://app.example.com

# All CORE processes load this one file. Each systemd unit uses UnsetEnvironment
# to expose only the database credentials and secrets required by that process.
# The email worker uses CORE_EMAIL_WORKER_DATABASE_URL, never DATABASE_URL.
