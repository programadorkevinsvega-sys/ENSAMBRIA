# BUSINESS HTTP runtime. Inject secrets from the deployment secret manager.
ENSAMBRIA_ENV=production
BUSINESS_HTTP_LISTEN_ADDRESS=0.0.0.0:8080
BUSINESS_DATABASE_URL=postgres://business_runtime@postgres.internal:5432/ensambria
BUSINESS_DATABASE_MAX_CONNECTIONS=32

# CORE authentication database pool (the role must have only CORE runtime grants).
DATABASE_URL=postgres://core_runtime@postgres.internal:5432/ensambria
CORE_DATABASE_MAX_CONNECTIONS=64
CORE_DATABASE_ACQUIRE_TIMEOUT_MS=1500
CORE_PUBLIC_BASE_URL=https://app.example.com
CORE_MFA_ENCRYPTION_KEY_VERSION=v1
CORE_MFA_ENCRYPTION_KEY_HEX=
CORE_AUTH_RATE_LIMIT_SECRET_HEX=

# Redis: direct | sentinel | cluster. Use authenticated rediss:// endpoints in production.
PLATFORM_REDIS_MODE=sentinel
PLATFORM_REDIS_POOL_SIZE=16
PLATFORM_REDIS_SENTINEL_URLS=rediss://sentinel-acl:REPLACE@redis-sentinel-1.internal:26379;rediss://sentinel-acl:REPLACE@redis-sentinel-2.internal:26379;rediss://sentinel-acl:REPLACE@redis-sentinel-3.internal:26379
PLATFORM_REDIS_SENTINEL_MASTER_NAME=ensambria-primary
PLATFORM_REDIS_USERNAME=ensambria-cache
PLATFORM_REDIS_PASSWORD=REPLACE_WITH_SECRET
# For direct mode use PLATFORM_REDIS_URL=rediss://acl-user:secret@redis.internal:6379/
# For cluster mode use PLATFORM_REDIS_CLUSTER_URLS=rediss://acl-user:secret@redis-1:6379;rediss://acl-user:secret@redis-2:6379;rediss://acl-user:secret@redis-3:6379
