# ENSAMBRIA shared staging/production environment.
# Copy this file to /etc/apps/ensambria/core/.env and replace ALL placeholders.
# Keep one shared .env. systemd units must use UnsetEnvironment to isolate credentials.
# Never commit the populated .env or print its values in CI logs.

ENSAMBRIA_ENV=production
RUST_LOG=info

# PostgreSQL — distinct least-privilege identities; same database is allowed.
DATABASE_URL=postgres://core_identity_auth_runtime:REPLACE_PASSWORD@POSTGRES_HOST:5432/ensambria
CORE_TENANCY_DATABASE_URL=postgres://core_tenancy_runtime:REPLACE_PASSWORD@POSTGRES_HOST:5432/ensambria
MIGRATIONS_DATABASE_URL=postgres://core_migrator:REPLACE_PASSWORD@POSTGRES_HOST:5432/ensambria
BUSINESS_DATABASE_URL=postgres://business_runtime:REPLACE_PASSWORD@POSTGRES_HOST:5432/ensambria
CORE_EMAIL_WORKER_DATABASE_URL=postgres://core_email_worker:REPLACE_PASSWORD@POSTGRES_HOST:5432/ensambria

# CORE PostgreSQL pool and local health/metrics listeners.
CORE_DATABASE_MAX_CONNECTIONS=5
CORE_DATABASE_ACQUIRE_TIMEOUT_MS=3000
CORE_HEALTH_LISTEN_ADDRESS=127.0.0.1:22080
CORE_METRICS_LISTEN_ADDRESS=127.0.0.1:22090
CORE_HEALTH_CHECK_INTERVAL_MS=5000
CORE_HEALTH_CHECK_TIMEOUT_MS=2000

# BUSINESS HTTP runtime and PostgreSQL pool.
BUSINESS_HTTP_LISTEN_ADDRESS=127.0.0.1:22100
BUSINESS_DATABASE_MAX_CONNECTIONS=32

# CORE authentication/security settings consumed by BUSINESS and CORE.
# Use a real externally reachable HTTPS origin, not the example value.
CORE_PUBLIC_BASE_URL=https://REPLACE_WITH_REAL_PUBLIC_HOST
CORE_MFA_ENCRYPTION_KEY_VERSION=REPLACE_WITH_STABLE_KEY_VERSION
# Generate once: exactly 32 cryptographically random bytes, represented by 64 hex characters.
CORE_MFA_ENCRYPTION_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
# Generate once: at least 32 cryptographically random bytes, represented as hex.
CORE_AUTH_RATE_LIMIT_SECRET_HEX=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS

# CORE email worker — independent identity and bounded pool.
CORE_EMAIL_WORKER_DATABASE_MAX_CONNECTIONS=3
CORE_EMAIL_WORKER_DATABASE_ACQUIRE_TIMEOUT_MS=3000
# Optional pool tuning:
# CORE_EMAIL_WORKER_DATABASE_IDLE_TIMEOUT_MS=30000
# CORE_EMAIL_WORKER_DATABASE_MAX_LIFETIME_MS=1800000

# SMTP (Resend example). Use a verified sender/domain and secret-managed credential.
CORE_SMTP_HOST=smtp.resend.com
CORE_SMTP_PORT=587
CORE_SMTP_USERNAME=resend
CORE_SMTP_PASSWORD=REPLACE_WITH_RESEND_API_KEY
CORE_SMTP_FROM=ENSAMBRIA <no-reply@REPLACE_WITH_VERIFIED_DOMAIN>

# Redis configuration. Choose and configure the mode required by this deployment.
# Direct:
# PLATFORM_REDIS_MODE=direct
# PLATFORM_REDIS_URL=rediss://USER:PASSWORD@REDIS_HOST:6379/
# Sentinel:
# PLATFORM_REDIS_MODE=sentinel
# PLATFORM_REDIS_SENTINEL_URLS=rediss://USER:PASSWORD@SENTINEL_1:26379;rediss://USER:PASSWORD@SENTINEL_2:26379;rediss://USER:PASSWORD@SENTINEL_3:26379
# PLATFORM_REDIS_SENTINEL_MASTER_NAME=ensambria-primary
# Cluster:
# PLATFORM_REDIS_MODE=cluster
# PLATFORM_REDIS_CLUSTER_URLS=rediss://USER:PASSWORD@REDIS_1:6379;rediss://USER:PASSWORD@REDIS_2:6379;rediss://USER:PASSWORD@REDIS_3:6379
# Optional shared Redis tuning/auth:
# PLATFORM_REDIS_POOL_SIZE=16
# PLATFORM_REDIS_USERNAME=ensambria-cache
# PLATFORM_REDIS_PASSWORD=REPLACE_WITH_REDIS_SECRET
# BUSINESS fail-closed behavior when Redis is a mandatory dependency:
# ENSAMBRIA_REDIS_REQUIRED=true

# Optional CORE pool tuning:
# CORE_DATABASE_IDLE_TIMEOUT_MS=30000
# CORE_DATABASE_MAX_LIFETIME_MS=1800000
