# Copy to .env on the NATS VM, replace placeholders, then set owner root:root
# and mode 0600. The installer refuses example values.
NATS_LISTEN_ADDRESS=REPLACE_WITH_PRIVATE_OR_TAILSCALE_IPV4
NATS_DNS_NAME=REPLACE_WITH_NATS_FQDN
NATS_EXPORTER_BIND_ADDRESS=REPLACE_WITH_PRIVATE_OR_TAILSCALE_IPV4
NATS_EXPORTER_DNS_NAME=REPLACE_WITH_EXPORTER_FQDN
NATS_ENVIRONMENT=REPLACE_WITH_environment
NATS_HOST_LABEL=REPLACE_WITH_STABLE_HOST_LABEL
NATS_PROMETHEUS_SERVER_NAME=REPLACE_WITH_EXPORTER_FQDN
NATS_PROMETHEUS_CA_FILE=/etc/prometheus/certs/ensambria-ca-bundle.crt
NATS_EXPORTER_HTTP_USER=nats-prom-scraper
NATS_PROMETHEUS_PASSWORD_FILE=/etc/prometheus/secrets/nats-scraper-password
NATS_NODE_EXPORTER_HTTP_USER=nats-node-prom-scraper
NATS_NODE_PROMETHEUS_PASSWORD_FILE=/etc/prometheus/secrets/nats-node-scraper-password
NATS_PROCESS_EXPORTER_HTTP_USER=nats-process-prom-scraper
NATS_PROCESS_PROMETHEUS_PASSWORD_FILE=/etc/prometheus/secrets/nats-process-scraper-password
NATS_AUTHORIZATION_FILE=/etc/ensambria/nats/authorization.conf
