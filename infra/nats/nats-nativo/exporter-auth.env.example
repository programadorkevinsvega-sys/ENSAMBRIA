# Provision this file on the NATS VM through the approved secret process.
# Store a bcrypt hash of a random scrape password here; place the original
# password only in Prometheus's protected password_file. Do not commit the
# provisioned file or reuse this example unchanged.
NATS_EXPORTER_HTTP_USER=nats-prom-scraper
NATS_EXPORTER_HTTP_BCRYPT_PASSWORD=REPLACE_WITH_BCRYPT_HASH
